{
  "name": "retainer-collections",
  "title": "Retainer Collections (Cash Basis)",
  "version": "1.3.0-dev.3",
  "description": "Lists retainer collections by client for a month on a cash basis, reconciled to the P&L. Replaces the export-to-spreadsheet workflow.",
  "vendor": "Esmeres Outsourcing & Consultancy Inc.",
  "entry": "src/index.html",
  "targetPage": "standalone",
  "permissions": [
    "read"
  ],
  "apiEndpoints": [
    "businesses",
    "profit-and-loss-statement-account-batch",
    "general-ledger-transactions-batch"
  ],
  "config": {
    "account": {
      "type": "string",
      "default": "Retainer",
      "description": "Income account name contains"
    },
    "currency": {
      "type": "string",
      "default": "PHP",
      "description": "Display currency symbol"
    }
  },
  "minManagerVersion": null,
  "channels": {
    "stable": "https://cesmeres.github.io/manager-extensions/retainer-collections/stable/",
    "beta": "https://cesmeres.github.io/manager-extensions/retainer-collections/beta/"
  }
}
